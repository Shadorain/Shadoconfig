#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
PACKAGES_DIR="$ROOT_DIR/packages"

cd "$PACKAGES_DIR"

echo "==> Removing all stowed packages..."

for dir in */; do
  echo "  -> ${dir%/}"
  stow -D "${dir%/}" 2>/dev/null || true
done

echo "✅ All symlinks removed"
